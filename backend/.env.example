# ========================================
# Parcel Kiosk 配置文件
# ========================================
# 复制本文件为 .env 并修改配置:
#   cp backend/.env.example backend/.env
# NAS 部署: 运行时 docker-compose.yml 的 environment: 
#           会覆盖 .env 中的值，.env 主要提供钉钉凭证
# ========================================

# ---- 钉钉应用凭证（必填）----
DINGTALK_APP_KEY=your_app_key
DINGTALK_APP_SECRET=your_app_secret
DINGTALK_AGENT_ID=your_agent_id

# ---- 服务地址 ----
# 本地开发：http://localhost:8000
# NAS 部署（Cloudflare）：https://kiosk.rayspring.dpdns.org
# NAS 部署（局域网）：http://192.168.3.100:8000
SERVER_BASE_URL=http://localhost:8000

# ---- 数据库路径 ----
# 本地开发：parcel.db（当前目录）
# Docker：/data/parcel.db（由 docker-compose 的 environment: 覆盖）
DB_PATH=parcel.db

# ---- 货架配置 ----
MAX_SHELVES=2    # 货架数量
MAX_LAYERS=4     # 每个货架的层数

# ---- 网络打印机 ----
# 打印机名（NAS 上 lpstat -a 查看）
PRINTER_NAME=HUAWEI_PixLab_V1_0409
# CUPS 主机地址
# 本地 Mac：localhost（使用本机 CUPS）
# Docker：打印机 IP（如 192.168.3.146，由 docker-compose 覆盖）
PRINTER_HOST=localhost

# ---- 快递公司 → 货架层映射 ----
# 格式：公司名:货架号-层号，逗号分隔
# 未配置的快递公司自动负载均衡到最空的区域
COURIER_LAYER_MAP=顺丰:1-1,中通:1-2,圆通:1-3,申通:1-4

# ---- Cloudflare Tunnel（NAS 部署必填）----
# 放在项目根目录 .env，不在 backend/.env 中
CF_TUNNEL_TOKEN=your_cloudflare_tunnel_token
