# 钉钉应用凭证
DINGTALK_APP_KEY=your_app_key
DINGTALK_APP_SECRET=your_app_secret
DINGTALK_AGENT_ID=your_agent_id

# 服务地址（NAS 部署时改为 Cloudflare 域名）
SERVER_BASE_URL=https://kiosk.rayspring.dpdns.org

# 数据库路径（Docker 内路径）
DB_PATH=/data/parcel.db

# 货架配置
MAX_SHELVES=2
MAX_LAYERS=4

# 打印机名（lpstat -a 查看）
PRINTER_NAME=HUAWEI_PixLab_V1_0409

# 快递公司 → 货架层映射（格式：公司名:货架号-层号，逗号分隔）
COURIER_LAYER_MAP=顺丰:1-1,中通:1-2,圆通:1-3,申通:1-4

# Cloudflare Tunnel Token（NAS 部署必填，放在项目根目录 .env）
CF_TUNNEL_TOKEN=your_cloudflare_tunnel_token
