<view class="container">
  <view a:if="{{loading}}" class="empty">加载中…</view>

  <view a:elif="{{packages.length === 0}}" class="empty">
    暂无待认领包裹
  </view>

  <block a:else a:for="{{packages}}" key="{{item.code}}">
    <view class="card">
      <text class="meta">{{item.courier}}</text>
      <text class="code">{{item.code}}</text>
      <text class="meta">到件：{{item.arrived_at}}</text>
      <text a:if="{{item.phone_tail}}" class="hint">
        收件手机尾号：{{item.phone_tail}}
      </text>
      <button class="btn btn-secondary" onTap="onClaim" data-pkgid="{{item.pkg_id}}" data-code="{{item.code}}">
        这是我的包裹
      </button>
    </view>
  </block>
</view>
